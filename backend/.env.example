# Copy to backend/.env for local overrides. Never commit .env or real credentials.

# Required by the private API, the owner CLI, and Alembic. /api/health works without it.
# This matches the local-only Docker Compose database in compose.yaml (development placeholder,
# not a secret). Any other database: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=postgresql+psycopg://internship_finder:local-dev-only@127.0.0.1:5432/internship_finder

# Absolute login session lifetime in hours (default 24).
SESSION_TTL_HOURS=24

# Keep true (the default). Chrome and Firefox accept Secure cookies on http://localhost. Set false
# only for plain-HTTP development on another host name. Hosted environments must use true.
SESSION_COOKIE_SECURE=true
