# Copy to backend/.env for local overrides. Never commit .env or real credentials.

# Required by the private API, the owner CLI, and Alembic. /api/health works without it.
# This matches the local-only Docker Compose database in compose.yaml (development placeholder,
# not a secret). Any other database: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE. A plain
# postgresql:// URL (as Neon shows it) also works; the app switches it to the psycopg driver.
DATABASE_URL=postgresql+psycopg://internship_finder:local-dev-only@127.0.0.1:5432/internship_finder

# Absolute login session lifetime in hours (default 24).
SESSION_TTL_HOURS=24

# Keep true (the default). Chrome and Firefox accept Secure cookies on http://localhost. Set false
# only for plain-HTTP development on another host name. Hosted environments must use true.
SESSION_COOKIE_SECURE=true

# Hosted deployment only (Render, docs/deployment.md). true disables /docs, /redoc, and
# /openapi.json and requires SESSION_COOKIE_SECURE=true. Leave unset locally.
# HOSTED=true

# Hosted deployment only: the random value (32+ characters) that Vercel's /api route sends as
# X-IF-Proxy-Secret, so login throttling can key on the browser address (ADR-009 §6). Set it in
# Render and in Vercel's Production environment only. Never commit a real value.
# PROXY_SHARED_SECRET=

# Test-only (E2E): read source-sync responses from a local JSON file instead of the network.
# Leave unset. Real syncs call the public source APIs listed in docs/sources.md.
# INGESTION_FIXTURE_FILE=
