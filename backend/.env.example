# Copy to backend/.env for local overrides. Never commit .env or real credentials.

# Exact origin of the frontend allowed by CORS (no trailing slash, never "*").
FRONTEND_ORIGIN=http://localhost:5173

# NOT required for the current health-only scaffold. Only database code and Alembic use it.
# Placeholder only; SQLAlchemy URL using the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
